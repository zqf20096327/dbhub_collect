# 敏感：绝不入库（GitHub token 在此）
.env

# 运行时产物
__pycache__/
*.pyc
logs/
.zcode/

# 采集工作区的中间数据（parts_* 是分通道原始结果，仅断点续采需要；
# README 正文自 2026-09-28 起入库，Actions 采集的唯一数据通道是 git）
data/snapshot_*/parts*/

# 状态轮转备份（atomic_write_json 的 .1~.4 备份）
state/*.json.[0-9]
state/*.json.[0-9][0-9]

# interpret 工作文件（分片/待办批，可再生）
state/pending_batch.json
state/shard_*.json
state/submit_shard_*.json
/shard_*.json
/submit_shard_*.json

# 杂项
*.tar.gz
submit.json
data/snapshot_latest/
.t_*
state/logs/

# 本地清理/同步的一次性工作目录与临时件（勿 add -A 入库）
_purge_backup_1001/
_remote_sync_1001/
_tmp_nothink.json

# 快照目录里的 atomic_write 轮转副本（同 state/ 规则；CI add -A 曾把 34 个/332MB 收进 git）
data/snapshot_*/*.json.[0-9]
data/snapshot_*/*.json.[0-9][0-9]
data/snapshot_*/meta/*.json.[0-9]
data/snapshot_*/meta/*.json.[0-9][0-9]

# interp_cache 分片写入的 tmp 瞬态件（只有崩溃残留才会留下）
state/interp_cache_shards/*.tmp

# 归档/切换工作目录（M1 起 release_archive 的包暂存；失败残留防 add -A 收进 git）
_archive_tmp/
data/live/*.ndjson.tmp

# 断连部分下载残留（sync_raw_ranged/采集中断的 .part）与 API 同步工具的树缓存（均本地产物）
state/*.part
data/snapshot_*/*.part
state/.sync_tree_cache.json
