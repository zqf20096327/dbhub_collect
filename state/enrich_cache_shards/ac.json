  "rel_notes": [
   {
    "t": "@electric-sql/pglite@0.5.14",
    "d": "2026-10-31",
    "n": "### Patch Changes\n\n- 1cf7e86: Only build the `pglite.wasm`, `initdb.wasm` and `pglite.data` URLs when PGlite has to load them. Passing `pgliteWasmModule`, `initdbWasmModule` and `fsBundle` now works in bundles where `import.meta.url` is undefined, such as an esbuild IIFE build.\n- 48dd3fb: Use PROXYFS instead of dumping the data dir from the scratch PGlite used for initdb when the data dir is in memory.\n- 268929b: do not copy parsers on each query"
   },
   {
    "t": "@electric-sql/pglite-vue@0.4.14",
    "d": "2026-10-31",
    "n": "### Patch Changes\n\n- Updated dependencies [1cf7e86]\n- Updated dependencies [48dd3fb]\n- Updated dependencies [268929b]\n  - @electric-sql/pglite@0.5.14\n  - @electric-sql/pglite-pgvector@0.0.15"
   },
   {
    "t": "@electric-sql/pglite-utils@0.0.5",
    "d": "2026-10-31",
    "n": "### Patch Changes\n\n- 48dd3fb: Use PROXYFS instead of dumping the data dir from the scratch PGlite used for initdb when the data dir is in memory."
   }
  ]
